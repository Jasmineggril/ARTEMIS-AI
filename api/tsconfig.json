{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "outDir": "../dist/api",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "baseUrl": "../",
    "paths": {
      "@shared/*": ["./shared/*"],
      "@/*": ["./client/src/*"]
    }
  },
  "include": ["./**/*", "../server/**/*", "../shared/**/*"]
}
