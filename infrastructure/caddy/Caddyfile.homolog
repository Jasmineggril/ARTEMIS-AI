# ARTEMIS AI — PRIVATE homologation (HTTPS + password for the whole site).
# Used by docker-compose.homolog.yml. HOMOLOG_USER / HOMOLOG_PASSWORD_HASH come
# from .env (hash generated by scripts/ops/deploy-homolog.sh with `caddy hash-password`).
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 16MB
	}
	# Not indexed by search engines while in homologation.
	header X-Robots-Tag "noindex, nofollow"
	basic_auth {
		{$HOMOLOG_USER} {$HOMOLOG_PASSWORD_HASH}
	}
	reverse_proxy api:5000 {
		health_uri /api/health
		health_interval 30s
	}
	log {
		output stdout
		format json
	}
}
