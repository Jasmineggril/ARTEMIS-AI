# ──────────────────────────────────────────────────────────────────────────
# Copie este arquivo para ".env" (mesma pasta) e ajuste os valores.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).
# ──────────────────────────────────────────────────────────────────────────

# ─── Banco de dados PostgreSQL (obrigatório para guardar os dados) ─────────
# Local:    postgresql://postgres:SUA_SENHA@localhost:5432/ceres_ai
# Supabase: use a "Connection string" do tipo "Session pooler" (porta 5432)
# Sem um banco acessível o app ainda abre, mas em "modo demonstração":
# os dados ficam só na memória e se perdem a cada reinício.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/ceres_ai

# Alternativa: se definida, tem prioridade sobre DATABASE_URL.
# SUPABASE_DATABASE_URL=

# ─── Sessões de login (obrigatório em produção) ────────────────────────────
# Use um texto aleatório e longo. Para gerar um:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-texto-aleatorio-e-longo

# ─── Servidor ──────────────────────────────────────────────────────────────
# Porta HTTP (padrão 5000). No macOS a 5000 costuma estar ocupada pelo
# "Receptor AirPlay" — nesse caso use 3000.
PORT=5000

# ─── Opcionais ─────────────────────────────────────────────────────────────
# Serviço Python de análise de risco (FastAPI). Se não estiver rodando,
# o motor de regras em TypeScript é usado automaticamente.
# PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Assistente de IA (chat). Sem chave, responde em modo offline.
# OPENAI_API_KEY=

# Dados de demonstração (sensores, alertas, fontes e a conta demo@ceres.ai),
# criados só quando as tabelas estão vazias. Use "false" para desativar.
# SEED_DEMO_DATA=true

# As variáveis VITE_* vão para o navegador e são lidas no momento do
# "npm run build" — defina-as ANTES de gerar o build.
# Modo de submissão anônima (oculta nomes e identidade dos proponentes):
# VITE_SUBMISSION_MODE=false
# Login pelo Supabase Auth (opcional; sem isso o login usa o próprio servidor):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
