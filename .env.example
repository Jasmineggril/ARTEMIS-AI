# ARTEMIS AI — variáveis de ambiente (copie para .env e preencha)
# NUNCA commite o arquivo .env real.

# Banco PostgreSQL (preferencial na VPS Hostinger)
DATABASE_URL=postgresql://artemis_app:SENHA@localhost:5432/artemis_ai

# Alternativa por partes (usado se DATABASE_URL não estiver definido)
PGHOST=localhost
PGPORT=5432
PGUSER=artemis_app
PGPASSWORD=
PGDATABASE=artemis_ai

# Fallback legado (Supabase) — apenas para migração; não preferir
# SUPABASE_DATABASE_URL=

# SSL para Postgres remoto (Supabase): require | prefer | disable
PGSSLMODE=disable

# Sessão (OBRIGATÓRIO em produção)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
NODE_ENV=development

# Serviço Python (FastAPI)
PYTHON_SERVICE_URL=http://127.0.0.1:8000
RISK_ENGINE=python
# RISK_ENGINE_MODE=ml-experimental  # apenas para habilitar o modelo RF sintético

# Rate limit (desabilitar apenas em testes)
# RATE_LIMIT_DISABLED=true

# Fallback em memória (apenas dev; nunca em produção)
# STORAGE_MEMORY_FALLBACK=true

# Submissão anônima
# VITE_SUBMISSION_MODE=true

# URL pública (para links de reset de senha)
# PUBLIC_BASE_URL=https://artemis.exemplo.com

# OpenAI (assistente de chat) — opcional
# OPENAI_API_KEY=