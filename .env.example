# ARTEMIS AI —modelo de variáveis de ambiente
#   cp .env.example .env && chmod 600 .env
# Nunca versionar .env. As variáveis abaixo SEM valor são obrigatórias: o Compose
# recusa subir até que sejam preenchidas. Não use estes valores em produção.
# Secrets apenas aqui (ambiente), nunca no código, no Git ou em logs.

# ─── Obrigatórias (produção e homologação) ────────────────────────────────────
# Domínio público da aplicação (registro A/AAAA já apontando para a VPS).
APP_DOMAIN=
# E-mail para o Let's Encrypt (Caddy).
ACME_EMAIL=
# Usuário superusuario do PostgreSQL; use apenas para administração.
POSTGRES_ADMIN_USER=artemis_admin
POSTGRES_ADMIN_PASSWORD=
# Dono do schema: usado SOMENTE pelo serviço one-shot `migrate`.
ARTEMIS_OWNER_PASSWORD=
# Papel da aplicação: SELECT/INSERT/UPDATE/DELETE, sem DDL.
ARTEMIS_APP_PASSWORD=
# Mínimo de 32 caracteres. A API recusa iniciar em produção sem ele.
SESSION_SECRET=

# ─── Homologação privada (apenas com -f docker-compose.homolog.yml) ───────────
# O scripts/ops/deploy-homolog.sh gera o hash e o usuário se estiverem vazios.
HOMOLOG_USER=avaliacao
HOMOLOG_PASSWORD_HASH=

# ─── Opcionais (valores abaixo = padrões atuais do código/Compose) ────────────
# Links absolutos nos e-mails de notificação. Se vazio, os links ficam relativos.
# APP_URL=

# Motor de risco. RISK_ENGINE=ts desativa a chamada ao serviço Python.
# RISK_ENGINE=python
# RISK_ENGINE_MODE=rules
# ALERT_MIN_LEVEL=alto
# RISK_ALERT_DAYS=3
# RISK_USE_SISFOGO=true

# Agendador embutido na API (também protegido por advisory locks no banco).
# SCHEDULER_ENABLED=true
# INPE_SYNC_MINUTES=60
# SISFOGO_SYNC_HOURS=24
# INPE_RISK_SYNC_ENABLED=true
# INPE_RISK_SYNC_HOURS=6
# INMET_SYNC_ENABLED=true
# INMET_SYNC_HOURS=24
# NOTIFY_MINUTES=5

# Cache/consultas externas.
# WEATHER_CACHE_MINUTES=30
# WEATHER_STALE_MAX_MINUTES=180
# INPE_MAX_AGE_HOURS=6
# SISFOGO_PAGE_SIZE=20
# INPE_RF_RETRY_BASE_MS=5000

# E-mail (redefinição de senha e notificações). Sem SMTP, os alertas ficam pendentes.
# SMTP_URL=
# MAIL_FROM=

# OpenAI é opcional; sem chave, o chat anuncia "no_key" e não inventa respostas.
# OPENAI_API_KEY=

# Endereços adicionais autorizados a enviar requisições de navegador para /api.
# ALLOWED_ORIGINS=
# COOKIE_SECURE=true
# OPS_TELEMETRY_ENABLED=true

# ─── Desenvolvimento local (docker-compose.dev.yml) ───────────────────────────
# Descomente para rodar a API no host contra o PostgreSQL do Compose:
# DATABASE_URL=postgresql://artemis:artemis_dev@127.0.0.1:5432/artemis_dev
